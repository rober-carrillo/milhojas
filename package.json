{
  "name": "milhojas",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev:web": "pnpm --filter @milhojas/web dev",
    "dev:mobile": "pnpm --filter @milhojas/mobile start",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "build:web": "pnpm --filter @milhojas/web build",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local --schema public > packages/core/src/database.types.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "eslint": "^9.35.0",
    "globals": "^16.4.0",
    "supabase": "2.120.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.43.0"
  }
}
