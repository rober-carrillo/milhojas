# Copy to .env.local (web) or .env (mobile). Never commit real values.
# Public values only: the anon key is safe in clients because Row Level Security protects data.
# The service_role key must NEVER appear in app or web code.

# Web (Next.js)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Mobile (Expo)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
